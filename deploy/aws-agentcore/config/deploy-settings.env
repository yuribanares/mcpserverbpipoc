# ═══════════════════════════════════════════════════════════════════════════
# deploy-settings.env — names and choices used by the deployment scripts.
# Safe to commit: there are NO secrets in this file.
# The defaults work as-is. Change them only if you have a reason to.
# ═══════════════════════════════════════════════════════════════════════════

# AWS region (data centre location). Singapore is the closest to the Philippines.
AWS_REGION=ap-southeast-1

# Which settings profile to deploy:
#   demo        → config/demo.env        (same demo values as the local PoC)
#   production  → config/production.env  (copy it from production.example.env first)
PROFILE=demo

# How to send the MCP server code to AgentCore:
#   code       → (recommended) upload a .zip file. No Docker needed.
#   container  → build an ARM64 container image and push it to Amazon ECR.
DEPLOY_METHOD=code

# Names of the things the scripts create. Use only lowercase letters, numbers
# and hyphens, except RUNTIME_NAME (letters, numbers and underscores only).
NAME_PREFIX=bpi-mcp
RUNTIME_NAME=bpi_mcp_server
IAM_ROLE_NAME=BpiMcpAgentCoreRuntimeRole
ECR_REPO=bpi-mcp-server
COGNITO_POOL_NAME=bpi-mcp-partners

# Partner logins to create in Amazon Cognito (one "app client" each).
# The first one is used by the demo UI and the test script.
PARTNERS="dragonpay juanpay"

# The demo mock bank on Amazon Lightsail.
LIGHTSAIL_SERVICE=bpi-mock-bank
# Size of the Lightsail container: nano is the smallest and cheapest.
LIGHTSAIL_POWER=nano
