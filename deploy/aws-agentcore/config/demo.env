# ═══════════════════════════════════════════════════════════════════════════
# demo.env — the DEMO profile. Reproduces the local proof of concept exactly:
# same partners (DRAGONPAY, JUANPAY), same accounts, same OTP rules, same
# screens. Used when PROFILE=demo in deploy-settings.env (the default).
# Safe to commit: there are NO secrets in this file.
# ═══════════════════════════════════════════════════════════════════════════

# ── Part A: settings sent to the MCP server on AgentCore ────────────────────

# Which bank the MCP server calls. "auto" = the Lightsail mock bank created by
# scripts/01-deploy-mock-bank.sh.
BPI_API_URL=auto

# Partner registry (BPI's vault): "builtin" = the demo partners from the PoC.
PARTNER_REGISTRY_SOURCE=builtin

# How the partner proves who it is inside the server: "tool" = the same
# bpi_partner_authenticate step as the PoC (so the demo looks identical).
PARTNER_AUTH_MODE=tool

# Where login sessions are kept: "memory", like the PoC.
SESSION_STORE=memory

# Send the server's activity lines back to the demo UI so its terminal panels
# still fill up when the server runs on AWS.
ECHO_LOGS=true

# BPI request signing — not built in this PoC. Leave "off".
BPI_MESSAGE_SIGNING=off

# ── Part B: AWS infrastructure for this profile (used by the scripts) ───────

# PUBLIC = the server can reach the internet (needed to reach Lightsail).
NETWORK_MODE=PUBLIC

# How long an idle conversation keeps its server copy (in seconds).
# 3600 = 1 hour, so a presenter pausing mid-demo doesn't lose the session.
# (Allowed: 60–28800. AWS default: 900.)
IDLE_SESSION_TIMEOUT_SECONDS=3600
# Longest a server copy may live, in seconds (allowed: 60–28800; 28800 = 8 hours).
MAX_LIFETIME_SECONDS=28800

# Demo slow-down on the mock bank, in milliseconds, so the terminal cascade is
# watchable (same as the local PoC).
MOCK_BANK_LATENCY_MS=280
