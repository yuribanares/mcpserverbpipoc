# ── Copy this file to .env and fill in your values ──────────────────────────
# cp .env.example .env

# Your Google Gemini API key. Get one at https://aistudio.google.com/apikey
# → In GitHub Codespaces: `cp .env.example .env`, then paste your key below.
#   (See the README "Setting the key in GitHub Codespaces" for the full steps.)
# If left blank, the PoC still runs end-to-end using an offline scripted planner
# (no real LLM) so you can demo without a key.
GEMINI_API_KEY=

# Gemini model to use (function-calling capable). Defaults to gemini-3.6-flash.
# Google retires older model names over time — if you see a 404 "model ... is no
# longer available", set a current one here (e.g. gemini-3.6-flash or
# gemini-2.5-flash). If you hit a 429 "RESOURCE_EXHAUSTED / limit: 0" error, your
# key's project has no free-tier quota for that model — enable billing or try a
# different model. The app auto-falls back to the offline planner on any Gemini
# error so a demo is never blocked.
GEMINI_MODEL=gemini-3.6-flash

# Demo pacing: ms delay so each MCP→server→API hop visibly cascades. 0 = instant.
PACE_MS=350
BPI_API_LATENCY_MS=280

# Ports
PORT=3000
BPI_API_PORT=4000

# Partner / merchant branding shown on the BPI login consent screen
PARTNER_NAME=DRAGONPAY CORP

# Partner's MCP-layer access credentials — how the partner app authenticates to
# BPI's (BPI-owned) MCP server. These are NOT BPI Open Banking credentials; BPI
# maps them to the partner tenant and resolves that tenant's Open Banking secret
# server-side. Defaults match the demo "DRAGONPAY" tenant in the MCP server's
# partner registry (server/bpi-mcp-server.js).
PARTNER_MCP_CLIENT_ID=mcp_dragonpay_7f3a91
PARTNER_MCP_CLIENT_SECRET=mcps_dragonpay_4b9c2e7f10a8d6

# Simulated BPI partner credentials (issued during onboarding). Defaults match
# the sample values in the API contract — fine to leave as-is for the PoC.
BPI_CLIENT_ID=a3f7832f-0f15-46e2-9070-29e6e89f2c2e
BPI_CLIENT_SECRET=rF1yE3tQ4rP2tY2qQ8dQ4sM0vU2fM0oI0fT5bA7vX7bD8dU8cV
