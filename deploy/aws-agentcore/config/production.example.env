# ═══════════════════════════════════════════════════════════════════════════
# production.example.env — TEMPLATE for the PRODUCTION profile.
#
# How to use:
#   1. cp config/production.example.env config/production.env
#   2. Fill in every value marked  <<< CHANGE ME
#   3. In config/deploy-settings.env set PROFILE=production
#   4. Re-run scripts 03 and 05 (see docs/5-go-to-production.md)
#
# config/production.env is git-ignored. It holds no passwords either — real
# secrets live in AWS Secrets Manager, never in this file.
# ═══════════════════════════════════════════════════════════════════════════

# ── Part A: settings sent to the MCP server on AgentCore ────────────────────

# The REAL BPI Open Banking API base address (from BPI's API onboarding).
BPI_API_URL=https://api.bpi.example   # <<< CHANGE ME

# Load partners + their BPI credentials from AWS Secrets Manager.
# Create the secret with scripts/p1-create-partner-secret.sh.
PARTNER_REGISTRY_SOURCE=secretsmanager
PARTNER_REGISTRY_SECRET_ID=bpi-mcp/partner-registry

# "jwt" = identify the partner from its verified Cognito login token (one
# login instead of two). If the troubleshooting guide tells you the token does
# not reach the server, use "tool" instead — it is still secure.
PARTNER_AUTH_MODE=jwt

# Keep login sessions in a DynamoDB table so they survive restarts and expire
# automatically. Create it with scripts/p2-create-session-table.sh.
SESSION_STORE=dynamodb
SESSION_TABLE_NAME=bpi-mcp-sessions

# Never send logs back to callers in production. Logs go to Amazon CloudWatch.
ECHO_LOGS=false

# BPI request signing (JWE/JWT) from the API contract is NOT built yet. It must
# be implemented and switched on before going live (see docs/5-go-to-production.md).
BPI_MESSAGE_SIGNING=off

# ── Part B: AWS infrastructure for this profile (used by the scripts) ───────

# VPC = run inside your private network (recommended when BPI is reachable
# privately). PUBLIC = normal internet access.
NETWORK_MODE=VPC
# Only for NETWORK_MODE=VPC — comma-separated, no spaces:
VPC_SUBNET_IDS=subnet-aaaa1111,subnet-bbbb2222          # <<< CHANGE ME
VPC_SECURITY_GROUP_IDS=sg-cccc3333                      # <<< CHANGE ME

# Close idle conversations after 15 minutes (the AWS default).
IDLE_SESSION_TIMEOUT_SECONDS=900
MAX_LIFETIME_SECONDS=28800

# No mock bank in production.
MOCK_BANK_LATENCY_MS=0
